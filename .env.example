# =============================================================================
# ANNUAIRE ENTREPRISES FRANCE — Configuration d'environnement
# Copiez ce fichier en .env.local pour le développement
# Ne committez jamais .env.local dans Git
# =============================================================================

# --- Identité du site (configurable sans redéploiement complet) ---
NEXT_PUBLIC_SITE_NAME="Annuaire Entreprises France"
NEXT_PUBLIC_SITE_DOMAIN="example.com"
NEXT_PUBLIC_SITE_URL="https://example.com"
NEXT_PUBLIC_SITE_DESCRIPTION="Annuaire national des entreprises et établissements français"

# --- Éditeur (mentions légales) ---
EDITOR_NAME=""
EDITOR_LEGAL_FORM=""
EDITOR_ADDRESS=""
EDITOR_SIREN=""
EDITOR_EMAIL_CONTACT=""
EDITOR_EMAIL_DPO=""

# --- Base de données PostgreSQL ---
DATABASE_URL="postgresql://user:password@localhost:5432/annuaire_dev"
DATABASE_URL_READONLY="postgresql://readonly:password@localhost:5432/annuaire_dev"

# --- API INSEE Sirene (nécessite inscription sur portail-api.insee.fr) ---
# L'absence de clé désactive les appels API ; les stocks restent importables
INSEE_API_KEY=""
INSEE_API_BASE_URL="https://api.insee.fr/api-sirene/pref/siret"
INSEE_API_TIMEOUT_MS="30000"
INSEE_API_MAX_RETRIES="3"
INSEE_API_RATE_LIMIT_PER_SECOND="7"

# --- API Recherche Entreprises (publique, limite 7 req/s par IP) ---
RECHERCHE_ENTREPRISES_BASE_URL="https://recherche-entreprises.api.gouv.fr"
RECHERCHE_ENTREPRISES_USER_AGENT="AnnuaireEntreprisesFrance/0.1 (contact@example.com)"

# --- API Découpage Administratif (publique) ---
GEO_API_BASE_URL="https://geo.api.gouv.fr"

# --- Stockage objet (pour les fichiers importés volumineux) ---
# Optionnel pour le pilote local ; requis en production
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_IMPORTS=""
S3_REGION=""

# --- Cache & performance ---
# Durée de cache des pages de fiches en secondes (défaut: 3600 = 1h)
CACHE_REVALIDATE_ENTITY_SEC="3600"
# Durée de cache des pages géographiques (défaut: 21600 = 6h)
CACHE_REVALIDATE_GEO_SEC="21600"

# --- Imports ---
# Répertoire local de téléchargement (pour le pilote)
IMPORT_DOWNLOAD_DIR="./data/downloads"
# Répertoire de staging avant upsert
IMPORT_STAGING_DIR="./data/staging"
# Département pilote (code INSEE à 2 ou 3 caractères)
PILOT_DEPARTMENT="75"
# Taille des lots pour les upserts PostgreSQL
IMPORT_BATCH_SIZE="1000"
# Nombre de lignes max à traiter par lot de fichier
IMPORT_CHUNK_SIZE="50000"

# --- Synchronisation incrémentale ---
# Fenêtre de recouvrement en minutes (pour absorber les retards de l'API)
SYNC_OVERLAP_MINUTES="60"
# Cron expression pour la synchronisation quotidienne (défaut: 3h du matin)
SYNC_CRON="0 3 * * *"

# --- SEO ---
# Nombre minimal de fiches actives pour qu'une page soit indexable
SEO_MIN_ENTITIES_FOR_INDEX="1"
# Limite de pages dans les sitemaps
SITEMAP_MAX_URLS_PER_FILE="50000"
SITEMAP_MAX_FILE_SIZE_MB="50"

# --- AdSense (désactivé par défaut) ---
# Ne renseigner qu'après approbation Google AdSense et validation du site
NEXT_PUBLIC_ADSENSE_ENABLED="false"
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
# Identifiant de l'emplacement publicitaire principal (ex: ca-pub-XXXXXXXX)
NEXT_PUBLIC_ADSENSE_SLOT_MAIN=""

# --- Consentement (CMP) ---
# Identifiant de votre CMP certifiée IAB TCF (ex: Axeptio, Cookiebot, Didomi...)
NEXT_PUBLIC_CMP_ID=""
NEXT_PUBLIC_CMP_PROVIDER=""

# --- Administration ---
ADMIN_SECRET_KEY=""
ADMIN_SESSION_MAX_AGE_SEC="28800"

# --- Monitoring & logging ---
LOG_LEVEL="info"
# URL de webhook pour les alertes (optionnel)
ALERT_WEBHOOK_URL=""

# --- Développement uniquement ---
# Active le mode démo avec données synthétiques (ne jamais activer en prod)
DEMO_MODE="false"
